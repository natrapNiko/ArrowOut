@model LeaderboardViewModel
@{
    ViewData["Title"] = $"{Model.Option.Name} leaderboard";
}

<h1 class="h2 mb-1">Leaderboard</h1>
<p class="text-muted">A separate ranking for each game type, by points. Every board you clear scores once: <strong>Easy 1 point</strong>, <strong>Normal 4</strong>, <strong>Hard 10</strong>, <strong>Challenge 20</strong>. Ties are broken by stars, then fewest mistakes.</p>

@* Buttons back into the game: a new random game, the board you came from, or an unfinished one. *@
<div class="ao-leaderboard-actions mb-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form method="post" asp-controller="Challenge" asp-action="New" data-busy-text="Building…" class="m-0">
            @* On the Challenge tab this starts a Challenge game, everywhere else a random one. *@
            @if (Model.Kind == ChallengeKind.Challenge)
            {
                <input type="hidden" name="kind" value="@ChallengeKind.Challenge" />
            }
            <button type="submit" class="btn btn-ao">
                <i class="bi bi-shuffle me-1" aria-hidden="true"></i>@(Model.Kind == ChallengeKind.Challenge ? "Start new Challenge game" : "Start new game")
            </button>
        </form>
        @if (Model.FromChallengeId is { } from)
        {
            <a class="btn btn-outline-ao" asp-controller="Challenge" asp-action="Play" asp-route-id="@from">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to game #@from
            </a>
        }
        @if (Model.UnfinishedChallengeId is { } unfinished)
        {
            <a class="btn btn-outline-ao" asp-controller="Challenge" asp-action="Play" asp-route-id="@unfinished">
                <i class="bi bi-play-fill me-1" aria-hidden="true"></i>Continue game #@unfinished
            </a>
        }
    }
    else
    {
        <a class="btn btn-ao" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-play-fill me-1" aria-hidden="true"></i>Play for free
        </a>
    }
</div>

@* Normal links, not JS tabs, so every ranking has its own URL, works without JavaScript and can be shared. *@
<nav class="ao-kind-tabs mb-3" aria-label="Game type">
    @foreach (var option in ChallengeKindOption.All)
    {
        var active = option.Kind == Model.Kind;
        <a class="ao-kind-tab @option.CssClass @(active ? "is-active" : "")"
           asp-action="Index" asp-route-kind="@option.Kind" asp-route-from="@Model.FromChallengeId"
           aria-current="@(active ? "page" : null)">
            <i class="bi @option.Icon" aria-hidden="true"></i>
            <span>@option.Name</span>
            @if (option.Arrows is not null)
            {
                <small>@option.Arrows</small>
            }
        </a>
    }
</nav>

@if (Model.Entries.Items.Count == 0)
{
    <div class="ao-empty text-center py-5">
        <i class="bi bi-trophy display-6 d-block mb-2"></i>
        <p class="mb-0">No @Model.Option.Name wins yet — be the first!</p>
    </div>
}
else
{
    <div class="table-responsive ao-card">
        <table class="table table-borderless align-middle mb-0 ao-table">
            <thead>
                <tr>
                    <th scope="col" class="text-center" style="width: 4rem">#</th>
                    <th scope="col">Player</th>
                    <th scope="col" class="text-end">Points</th>
                    <th scope="col" class="text-end">Won</th>
                    <th scope="col" class="text-end">Stars</th>
                    <th scope="col" class="text-end d-none d-sm-table-cell">Mistakes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries.Items)
                {
                    <tr>
                        <td class="text-center">
                            @if (entry.Rank <= 3)
                            {
                                <span class="ao-medal ao-medal-@entry.Rank">@entry.Rank</span>
                            }
                            else
                            {
                                @entry.Rank
                            }
                        </td>
                        @* Players type their own names, but Razor encodes @ output, so this is safe. *@
                        <td class="fw-medium">@entry.PlayerName</td>
                        <td class="text-end fw-semibold">@entry.TotalPoints.ToString("N0")</td>
                        <td class="text-end">@entry.ChallengesWon</td>
                        <td class="text-end"><i class="bi bi-star-fill text-warning me-1"></i>@entry.TotalStars</td>
                        <td class="text-end d-none d-sm-table-cell">@entry.TotalMistakes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_Pagination" model="Model.Pagination" />
